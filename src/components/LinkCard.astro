---
export interface Props {
  title: string;
  href: string;
  description: string;
  badge?: string;
}

const { title, href, description, badge } = Astro.props;
---

<a class="card" href={href} target="_blank" rel="noreferrer">
  <div style="display:flex; align-items:center; gap:8px; justify-content:space-between;">
    <h2>{title}</h2>
    {badge && <span style="color: var(--accent); font-weight: 600; font-size: 0.9rem;">{badge}</span>}
  </div>
  <p>{description}</p>
</a>
